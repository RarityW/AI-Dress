{
  "name": "yijian-ai",
  "version": "0.1.0",
  "private": true,
  "description": "衣见 AI — 基于多模态视觉与个性化推荐的智能穿搭系统",
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "cd apps/web && npm run build",
    "lint:web": "cd apps/web && npm run lint",
    "typecheck:web": "cd apps/web && npm run typecheck",
    "test:api": "cd apps/api && python -m pytest",
    "test:web": "cd apps/web && npm test",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:down": "docker compose down"
  }
}
