# ============================================
# 衣见 AI (YIJIAN AI) — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ⚠️ 切勿将填入真实密钥的 .env 文件提交到 Git
# ============================================

# === 应用配置 ===
APP_ENV=development
APP_NAME=yijian-ai
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-to-a-random-secret-key

# === 数据库配置 ===
# 开发环境使用 SQLite
DATABASE_URL=sqlite:///./data/yijian.db
# 生产环境使用 PostgreSQL (取消注释并配置)
# DATABASE_URL=postgresql://user:password@localhost:5432/yijian_ai

# === AI 模型配置 ===
# OpenAI 兼容 API (支持 OpenAI / 智谱 / 通义千问 / DeepSeek 等)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o
AI_CHAT_MODEL=gpt-4o-mini

# === 天气 API 配置 ===
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.seniverse.com/v3

# === 前端配置 ===
VITE_API_BASE_URL=http://localhost:8000

# === Docker / 部署配置 ===
COMPOSE_PROJECT_NAME=yijian-ai
IMAGE_TAG=latest

# === 推荐算法权重配置 (可选覆盖默认值) ===
# WEIGHT_WEATHER=0.35
# WEIGHT_STYLE=0.25
# WEIGHT_SCENE=0.20
# WEIGHT_COLOR=0.15
# WEIGHT_PREFERENCE=0.05
